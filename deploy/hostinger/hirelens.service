[Unit]
Description=HireLens Django application
After=network.target

[Service]
Type=notify
User=hirelens
Group=www-data
WorkingDirectory=/opt/hirelens/app
EnvironmentFile=/opt/hirelens/app/.env
RuntimeDirectory=hirelens
RuntimeDirectoryMode=0755
ExecStart=/opt/hirelens/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/hirelens/gunicorn.sock \
    --workers 2 \
    --threads 4 \
    --umask 007 \
    --timeout 90 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
