# Never commit your real secrets. Copy this file to .env only for local use.
OPENAI_API_KEY=replace-with-your-project-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_INTERVIEW_MODEL=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VOICE_FEMALE=marin
OPENAI_REALTIME_VOICE_MALE=cedar
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_REQUESTS_PER_INTERVIEW=4
INTERVIEW_STARTS_PER_HOUR=5
INTERVIEW_DEFAULT_MINUTES=12
INTERVIEW_MAX_MINUTES=20
# Strongly recommended for a public deployment; share it only with candidates.
INTERVIEW_ACCESS_CODE=

DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
SECURE_SSL_REDIRECT=false

# Production platforms normally provide this automatically.
DATABASE_URL=

# Hostinger MySQL alternative to DATABASE_URL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
